generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProjectType {
  DEVELOPMENT
  DESIGN
  HYBRID
}

enum BlockType {
  HEADING
  PARAGRAPH
  IMAGE
  IMAGE_GROUP
  QUOTE
  VIDEO
  CODE
  TECH_CALLOUT
}

enum MediaRole {
  GALLERY
  THUMBNAIL
  SUPPORTING
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique @db.VarChar(320)
  passwordHash String
  role         Role          @default(OWNER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     AuthSession[]
  utilityData  UtilityData[]
}

model AuthSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Project {
  id            String        @id @default(uuid()) @db.Uuid
  title         String        @db.VarChar(160)
  slug          String        @unique @db.VarChar(180)
  summary       String        @db.VarChar(320)
  description   String?       @db.Text
  type          ProjectType
  status        ProjectStatus @default(DRAFT)
  year          Int
  role          String        @db.VarChar(160)
  client        String?       @db.VarChar(160)
  technologies  Json
  services      Json
  githubUrl     String?       @db.VarChar(2048)
  liveUrl       String?       @db.VarChar(2048)
  behanceUrl    String?       @db.VarChar(2048)
  externalUrl   String?       @db.VarChar(2048)
  featured      Boolean       @default(false)
  sortOrder     Int           @default(0)
  coverImageId  String?       @db.Uuid
  coverOmitted  Boolean       @default(false)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  coverImage    MediaAsset?   @relation("ProjectCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  blocks        ProjectBlock[]
  media         ProjectMedia[]

  @@index([status, featured, sortOrder])
  @@index([updatedAt])
}

model ProjectBlock {
  id        String    @id @default(uuid()) @db.Uuid
  projectId String    @db.Uuid
  type      BlockType
  content   Json
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
}

model MediaAsset {
  id                  String           @id @default(uuid()) @db.Uuid
  storageKey          String           @unique @db.VarChar(512)
  fileName            String           @db.VarChar(255)
  originalName        String           @db.VarChar(255)
  mimeType            String           @db.VarChar(120)
  width               Int?
  height              Int?
  sizeBytes           Int
  altText             String           @default("") @db.VarChar(500)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  projectCovers       Project[]        @relation("ProjectCover")
  projectMedia        ProjectMedia[]
  milestoneReferences Milestone[]
  playgroundThumbnails PlaygroundItem[] @relation("PlaygroundThumbnail")

  @@index([createdAt])
}

model ProjectMedia {
  id           String     @id @default(uuid()) @db.Uuid
  projectId    String     @db.Uuid
  mediaAssetId String     @db.Uuid
  role         MediaRole  @default(GALLERY)
  sortOrder    Int        @default(0)
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([projectId, mediaAssetId, role])
  @@index([projectId, role, sortOrder])
}

model Milestone {
  id           String      @id @default(uuid()) @db.Uuid
  title        String      @db.VarChar(180)
  description  String      @db.Text
  date         DateTime
  type         String      @db.VarChar(80)
  visible      Boolean     @default(true)
  sortOrder    Int         @default(0)
  mediaAssetId String?     @db.Uuid
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([visible, sortOrder, date])
}

model PlaygroundItem {
  id          String        @id @default(uuid()) @db.Uuid
  title       String        @db.VarChar(180)
  slug        String        @unique @db.VarChar(180)
  summary     String        @db.VarChar(320)
  type        String        @db.VarChar(80)
  status      ProjectStatus @default(DRAFT)
  content     Json
  thumbnailId String?       @db.Uuid
  liveUrl     String?       @db.VarChar(2048)
  sourceUrl   String?       @db.VarChar(2048)
  sortOrder   Int           @default(0)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  thumbnail   MediaAsset?   @relation("PlaygroundThumbnail", fields: [thumbnailId], references: [id], onDelete: SetNull)

  @@index([status, sortOrder])
}

model SiteSetting {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt
}

model UtilityData {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  namespace String   @db.VarChar(100)
  key       String   @db.VarChar(100)
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, namespace, key])
  @@index([userId, namespace])
}
